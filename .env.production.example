# =============================================================================
# SiteAnswer — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before deploying.
# Lines marked [REQUIRED] must be set. Lines marked [OPTIONAL] enable features.

# --- Server ---
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
API_BASE_URL=https://api.yourdomain.com

# --- Supabase [REQUIRED] ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Redis [REQUIRED] ---
REDIS_URL=redis://your-redis-host:6379

# --- Frontend URL [REQUIRED] (for CORS) ---
FRONTEND_URL=https://app.yourdomain.com

# --- Encryption Key [REQUIRED] ---
# 32-byte hex string for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- ElevenLabs [OPTIONAL — enables AI voice agent] ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Twilio [OPTIONAL — enables telephony + WhatsApp] ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_WHATSAPP_NUMBER=+1...

# --- GoHighLevel CRM [OPTIONAL] ---
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://api.yourdomain.com/api/v1/ghl/oauth/callback

# --- Xero Accounting [OPTIONAL] ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://api.yourdomain.com/api/v1/accounting/oauth/callback

# --- QuickBooks Accounting [OPTIONAL] ---
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=https://api.yourdomain.com/api/v1/accounting/oauth/callback

# --- Google Calendar [OPTIONAL] ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/calendar/oauth/callback

# --- Microsoft Outlook Calendar [OPTIONAL] ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://api.yourdomain.com/api/v1/calendar/oauth/callback

# --- Alerts [OPTIONAL] ---
ALERT_EMAIL=
COST_ALERT_THRESHOLD_MONTHLY=2000

# --- Next.js Frontend (pass as build args for web container) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
